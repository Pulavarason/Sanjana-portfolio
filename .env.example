# Copy to .env.local and fill in. Nothing here is required to run the site.

# Public URL of the site (used for SEO / social previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact details (digits only for WhatsApp, with country code, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE=

# Optional: a form service endpoint (e.g. Formspree: https://formspree.io/f/xxxxxx).
# When set, the enquiry form posts straight to it. When empty, the form hands the
# enquiry over to WhatsApp / email using the details above.
NEXT_PUBLIC_FORM_ENDPOINT=
